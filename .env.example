# Copy to .env and provide local values. Do not commit real secrets.

POSTGRES_DB=identity_db
NOTIFICATION_POSTGRES_DB=notification_db
POSTGRES_USER=vednex
POSTGRES_PASSWORD=change-me

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=vednex
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

APP_FRONTEND_URL=http://localhost:3000
APP_BACKEND_URL=http://localhost:8081
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
IDENTITY_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
IDENTITY_SERVICE_URL=http://localhost:8081

JWT_PRIVATE_KEY=<base64-or-pem-private-key>
JWT_PUBLIC_KEY=<base64-or-pem-public-key>
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
JWT_ISSUER=vednex-identity-service
JWT_AUDIENCE=vednex-business-suite
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@vednex.local
MAIL_LOG_TOKEN_LINKS=false
MAIL_SMTP_AUTH=true

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
NOTIFICATION_MAIL_HOST=mailpit
NOTIFICATION_MAIL_PORT=1025
NOTIFICATION_MAIL_USERNAME=
NOTIFICATION_MAIL_PASSWORD=
NOTIFICATION_MAIL_FROM=no-reply@vednex.local
NOTIFICATION_MAIL_SMTP_AUTH=false
NOTIFICATION_MAIL_SMTP_STARTTLS_ENABLE=false
NOTIFICATION_MAIL_SMTP_STARTTLS_REQUIRED=false

EVENTS_EXCHANGE=vednex.events
EVENTS_DLX=vednex.events.dlx
EVENTS_ARCHIVE_QUEUE=vednex.events.identity.archive
EVENTS_DLQ=vednex.events.dlq
EVENTS_PRODUCER=identity-service
NOTIFICATION_IDENTITY_QUEUE=vednex.notification.identity
NOTIFICATION_CONSUMER_NAME=notification-service
NOTIFICATION_EMAIL_MAX_ATTEMPTS=3
NOTIFICATION_EMAIL_RETRY_BASE_MS=500

OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_RETRIES=10
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_PUBLISH_CONFIRM_TIMEOUT_MS=5000
