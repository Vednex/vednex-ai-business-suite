APP_NAME=crm-service
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8083

API_PREFIX=/api/crm

DATABASE_URL=postgresql+psycopg://vednex:change-me@localhost:5432/crm_db

JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=../../secrets/jwt-public.pem
JWT_ISSUER=vednex-identity-service
JWT_AUDIENCE=vednex-business-suite

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
LOG_LEVEL=INFO
